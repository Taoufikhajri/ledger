# Password required to open the app (Basic Auth). Leave unset to disable the gate.
APP_PASSWORD=changeme

# These are added automatically when you create/link a Vercel KV database —
# you don't need to set them by hand. Listed here just so you know what to expect:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
