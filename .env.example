# These are added automatically when you create/connect a Redis database
# from Vercel's Storage/Marketplace tab — you don't need to set them by hand.
# Listed here just so you know what to expect:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# (or, depending on how the integration names them:)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
